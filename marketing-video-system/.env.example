# Google Gemini API - fill in the key locally.
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Runtime limits for the discovery demo.
MAX_PAGES=6
MAX_PROBES=6
LLM_TIMEOUT_SECONDS=90
ANONYMIZED_TELEMETRY=false

# Optional providers; unused while MODEL_PROVIDER=google.
BROWSER_USE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
